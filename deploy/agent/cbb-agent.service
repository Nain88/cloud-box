[Unit]
Description=Cyber Black Box authorized collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cbb-agent
Group=cbb-agent
WorkingDirectory=@PROJECT_DIR@
ExecStart=@PROJECT_DIR@/.venv/bin/python -m cbb.agent --config /etc/cbb-agent/agent.json run
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/cbb-agent
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
