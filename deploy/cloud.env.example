# Generate distinct random values; hex values avoid URL encoding ambiguity.
CBB_HOST=cbb.example.edu
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
CBB_SIGNER_TOKEN=REPLACE_WITH_64_HEX_CHARACTERS
CBB_PROXY_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
# A separately administered witness over HTTPS; leave empty until configured.
CBB_WITNESS_URL=
CBB_WITNESS_PUBLIC_KEY=
CBB_WITNESS_INDEPENDENT=false
# Existing S3 bucket with versioning and Object Lock enabled; use workload IAM.
CBB_S3_BUCKET=
CBB_S3_ENDPOINT=
CBB_S3_RETENTION_MODE=GOVERNANCE
CBB_S3_RETENTION_DAYS=90
