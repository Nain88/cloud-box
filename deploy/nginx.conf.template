server {
    listen 443 ssl;
    server_name ${CBB_HOST};
    ssl_certificate /etc/nginx/tls/server.crt;
    ssl_certificate_key /etc/nginx/tls/server.key;
    ssl_client_certificate /etc/nginx/tls/client-ca.crt;
    ssl_verify_client optional;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 260m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location ~ ^/api/v1/(ingest/|receipts/|collectors/heartbeat$|collector-jobs|uploads) {
        if ($ssl_client_verify != SUCCESS) { return 403; }
        proxy_set_header X-Proxy-Secret "${CBB_PROXY_SECRET}";
        proxy_set_header X-Client-Cert $ssl_client_escaped_cert;
        proxy_set_header Host $host;
        proxy_pass http://app:8765;
        proxy_read_timeout 180s;
    }
    location / {
        proxy_set_header X-Proxy-Secret "";
        proxy_set_header X-Client-Cert "";
        proxy_set_header Host $host;
        proxy_pass http://app:8765;
        proxy_read_timeout 180s;
    }
}
